# ==============================================================================
# Ahmad Executive Agent (Agent 1) - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# IMPORTANT: NEVER commit your real .env file or credentials to source control.
# ==============================================================================

# Google Gemini Neural Brain API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token from @BotFather & Authorized Owner Telegram Chat/User ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# Server Port
PORT=3000

# Facebook Meta Graph API Credentials & Permanent Page Token
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FB_APP_ID=your_facebook_app_id_here
FB_APP_SECRET=your_facebook_app_secret_here

# D-ID Talking Avatar Cloud Engine API Key (https://studio.d-id.com/)
DID_API_KEY=your_did_api_key_here

# Optional Custom Directory Paths (Defaults will automatically resolve dynamically)
# GOOGLE_DRIVE_PATH=G:\My Drive
# AGENT_BASE_DIR=
# OUTPUT_DIR=
